{
  "degradationId": "recommendations.fetch",
  "evaluationInterval": "5s",
  "signalSource": {
    "prometheus": {
      "query": "clamp_max((sum(rate(http_client_requests_seconds_sum{job=\"demo-client\",client_name=\"demo-server\"}[30s])) / clamp_min(sum(rate(http_client_requests_seconds_count{job=\"demo-client\",client_name=\"demo-server\"}[30s])), 0.01)) / 2.0, 1.0) or on() vector(0)"
    }
  },
  "criticalThreshold": 0.1,
  "minFallbackRatio": 0.0,
  "maxFallbackRatio": 0.3,
  "fallbackCurveExponent": 1.0
}
